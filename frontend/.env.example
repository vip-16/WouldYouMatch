# WouldYouMatch? Frontend Environment Variables
# These variables are baked into the client bundle at build time (e.g. on Vercel, Netlify, Render, Cloudflare Pages).

# Base HTTP API URL of the deployed FastAPI backend
# Default in development: http://localhost:8000
VITE_API_URL=https://api.wouldyoumatch.app

# Optional WebSocket URL. If not provided, it is automatically derived from VITE_API_URL (http -> ws, https -> wss)
# VITE_WS_URL=wss://api.wouldyoumatch.app
