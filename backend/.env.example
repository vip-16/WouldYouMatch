# WouldYouMatch? Backend Environment Variables (Production & Development)

# Environment Mode ("production" enforces HTTPS reverse-proxy redirects)
ENVIRONMENT=development

# Google Gemini API key for dynamic dilemma question generation
# Get your free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated). Leave empty for default localhost + wouldyoumatch.app
ALLOWED_ORIGINS=https://wouldyoumatch.app,https://www.wouldyoumatch.app

# Frontend URL for social share cards & Open Graph links
FRONTEND_URL=https://wouldyoumatch.app

# Optional custom SQLite database location (e.g., for Docker persistent volumes or /data mount)
# DATABASE_PATH=/data/wouldyoumatch.db
